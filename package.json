{
  "name": "fiskit",
  "version": "0.1.0",
  "description": "Official Node.js client for the FisKit API: electronic invoices with ARCA (ex AFIP) in a single request.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
